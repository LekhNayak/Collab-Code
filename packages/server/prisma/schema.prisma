generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum RoomType {
  COLLAB
  EXAM
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String?
  avatarUrl      String?
  role           UserRole @default(STUDENT)
  githubUsername String?
  githubPat      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspaces      WorkspaceMember[]
  ownedWorkspaces Workspace[]

  ownedExams      Exam[] @relation("ExamOwner")
  examLogs        ExamLog[]
  examSessions    ExamSession[]
}

// id is the workspace id used on disk (room code, or EX-xxxx__userId for exams)
model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
  files   File[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        Role      @default(VIEWER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// Durable copy of a workspace file, so workspaces survive an ephemeral disk (Render free plan).
// The disk stays the working copy; WorkspaceStore restores missing files from here.
model File {
  id          String    @id @default(uuid())
  workspaceId String
  path        String    // normalized, e.g. "/src/index.ts"
  name        String
  type        FileType
  content     String?
  data        Bytes?    // raw file bytes
  sha1        String?
  size        Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, path])
}

// IDE session state (open tabs, active tab, installed extensions), keyed by room id
model IdeSession {
  id        String   @id
  owner     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomExtension {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
}

enum FileType {
  FILE
  DIRECTORY
}

model Room {
  id             String   @id @default(uuid())
  type           RoomType
  name           String?
  examId         String?
  exam           Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdByRole  UserRole
  createdAt      DateTime @default(now())
}

model Exam {
  id          String    @id @default(uuid())
  title       String
  ownerId     String
  owner       User      @relation("ExamOwner", fields: [ownerId], references: [id])
  startTime   DateTime
  endTime     DateTime?
  rooms       Room[]
  sessions    ExamSession[]
  logs        ExamLog[]
  createdAt   DateTime  @default(now())
}

model ExamSession {
  id             String    @id @default(uuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  startTime      DateTime  @default(now())
  endTime        DateTime?
  status         String    @default("ACTIVE")
  tabSwitchCount Int       @default(0)
  isBlocked      Boolean   @default(false)
  blockedAt      DateTime?
  blockedReason  String?
}

model ExamLog {
  id             String    @id @default(uuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  eventType      LogType
  codeSnapshot   String?   // State of the code at the time of the event
  details        String?   // JSON object with details (as string)
  createdAt      DateTime  @default(now())
}

enum LogType {
  JOIN
  LEAVE
  EXECUTE
  COPY_PASTE_ALERT
  SUSPICIOUS_BEHAVIOR
  TAB_SWITCH
  FULLSCREEN_EXIT
}

