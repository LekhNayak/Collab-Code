generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum RoomType {
  COLLAB
  EXAM
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  password       String?
  avatarUrl      String?
  role           UserRole @default(STUDENT)
  githubUsername String?
  githubPat      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspaces      WorkspaceMember[]
  ownedWorkspaces Workspace[]

  ownedExams   Exam[]        @relation("ExamOwner")
  examLogs     ExamLog[]
  examSessions ExamSession[]

  ownedContests         Contest[]            @relation("ContestOwner")
  contestParticipations ContestParticipant[]
  submissions           Submission[]
  contestEvents         ContestEvent[]
}

// id is the workspace id used on disk (room code, or EX-xxxx__userId for exams)
model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
  files   File[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        Role      @default(VIEWER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

// Durable copy of a workspace file, so workspaces survive an ephemeral disk (Render free plan).
// The disk stays the working copy; WorkspaceStore restores missing files from here.
model File {
  id          String    @id @default(uuid())
  workspaceId String
  path        String // normalized, e.g. "/src/index.ts"
  name        String
  type        FileType
  content     String?
  data        Bytes? // raw file bytes
  sha1        String?
  size        Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, path])
}

// IDE session state (open tabs, active tab, installed extensions), keyed by room id
model IdeSession {
  id        String   @id
  owner     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomExtension {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
}

enum FileType {
  FILE
  DIRECTORY
}

model Room {
  id            String   @id @default(uuid())
  type          RoomType
  name          String?
  examId        String?
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdByRole UserRole
  createdAt     DateTime @default(now())
}

model Exam {
  id        String        @id @default(uuid())
  title     String
  ownerId   String
  owner     User          @relation("ExamOwner", fields: [ownerId], references: [id])
  startTime DateTime
  endTime   DateTime?
  rooms     Room[]
  sessions  ExamSession[]
  logs      ExamLog[]
  createdAt DateTime      @default(now())
}

model ExamSession {
  id             String    @id @default(uuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  startTime      DateTime  @default(now())
  endTime        DateTime?
  status         String    @default("ACTIVE")
  tabSwitchCount Int       @default(0)
  isBlocked      Boolean   @default(false)
  blockedAt      DateTime?
  blockedReason  String?
}

model ExamLog {
  id           String   @id @default(uuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  eventType    LogType
  codeSnapshot String? // State of the code at the time of the event
  details      String? // JSON object with details (as string)
  createdAt    DateTime @default(now())
}

enum LogType {
  JOIN
  LEAVE
  EXECUTE
  COPY_PASTE_ALERT
  SUSPICIOUS_BEHAVIOR
  TAB_SWITCH
  FULLSCREEN_EXIT
}

// ─── Competitive-coding contests ─────────────────────────────────────────────
// Phase is derived from startsAt/endsAt: DRAFT (no start), SCHEDULED, LIVE, ENDED.
// Each participant's code lives in the collab workspace "<code>__<userId>", one file per problem.

enum ProblemKind {
  CODE // stdin/stdout program in any allowed language
  SQL // one SQLite query, judged on a dataset per test
}

enum ContestLeaderboard {
  LIVE // participants see the leaderboard during the contest
  AFTER_END // hidden from participants until the contest ends
}

enum ContestParticipantStatus {
  ACTIVE
  BLOCKED
  REMOVED
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  DONE
  ERROR // the execution backend failed; never counts towards the score
}

enum Verdict {
  AC
  PARTIAL
  WA
  TLE
  MLE
  RE
  CE
  OLE
  IE
  SKIPPED
}

enum ContestEventType {
  JOIN
  TAB_SWITCH
  FULLSCREEN_EXIT
  PASTE
  BLOCK
  UNBLOCK
  REMOVE
  START
  END
}

model Contest {
  id              String             @id @default(uuid())
  code            String             @unique // CT-XXXXXXXX, also the workspace prefix
  title           String
  description     String             @default("")
  ownerId         String
  owner           User               @relation("ContestOwner", fields: [ownerId], references: [id])
  startsAt        DateTime?
  endsAt          DateTime?
  durationMinutes Int                @default(120)
  languages       String[]           @default([]) // empty = all supported languages
  proctoring      Boolean            @default(false)
  maxTabSwitches  Int                @default(3)
  leaderboard     ContestLeaderboard @default(LIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  problems     Problem[]
  participants ContestParticipant[]
  submissions  Submission[]
  events       ContestEvent[]

  @@index([ownerId])
}

model Problem {
  id            String   @id @default(uuid())
  contestId     String
  contest       Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  index         String // "A", "B", ... — names the participant's files, locked once the contest starts
  title         String
  statement     String   @default("") // markdown
  points        Int      @default(100)
  timeLimitMs   Int      @default(2000)
  memoryLimitMb Int?
  updatedAt     DateTime @updatedAt // bumped when tests change

  // SQL problems: each test's input is a dataset (INSERTs) and its expected output the reference
  // query's result as JSON { columns, rows }, computed by the server
  kind            ProblemKind @default(CODE)
  sqlSchema       String      @default("") // CREATE TABLE statements, shown to participants
  sqlSolution     String      @default("") // reference query, never sent to participants
  sqlOrderMatters Boolean     @default(false)

  tests       TestCase[]
  submissions Submission[]

  @@unique([contestId, index])
}

model TestCase {
  id             String  @id @default(uuid())
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isSample       Boolean @default(false) // samples are shown to participants
  order          Int

  @@index([problemId, order])
}

model ContestParticipant {
  id             String                   @id @default(uuid())
  contestId      String
  contest        Contest                  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId         String
  user           User                     @relation(fields: [userId], references: [id])
  status         ContestParticipantStatus @default(ACTIVE)
  tabSwitchCount Int                      @default(0)
  blockedReason  String?
  joinedAt       DateTime                 @default(now())

  @@unique([contestId, userId])
  @@index([userId])
}

model Submission {
  id            String           @id @default(uuid())
  contestId     String
  contest       Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId     String
  problem       Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  language      String
  code          String
  status        SubmissionStatus @default(QUEUED)
  verdict       Verdict?
  passed        Int              @default(0)
  total         Int              @default(0)
  score         Float            @default(0)
  results       Json             @default("[]") // per test: { verdict, timeMs, timeExact, sample, ... }
  compileOutput String?
  createdAt     DateTime         @default(now()) // ranking tie-break uses this, never finishedAt
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime         @updatedAt // judge heartbeat

  @@index([contestId, createdAt])
  @@index([contestId, userId, problemId])
  @@index([status, updatedAt])
}

model ContestEvent {
  id        String           @id @default(uuid())
  contestId String
  contest   Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  type      ContestEventType
  details   Json?
  createdAt DateTime         @default(now())

  @@index([contestId, createdAt])
}
