generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces      WorkspaceMember[]
  ownedWorkspaces Workspace[]

  ownedExams      ExamRoom[] @relation("ExamOwner")
  examLogs        ExamLog[]
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
  files   File[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        Role      @default(VIEWER)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model File {
  id          String    @id @default(uuid())
  workspaceId String
  path        String
  name        String
  type        FileType
  content     String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FileType {
  FILE
  DIRECTORY
}

model ExamRoom {
  id          String    @id @default(uuid())
  title       String
  ownerId     String
  owner       User      @relation("ExamOwner", fields: [ownerId], references: [id])
  startTime   DateTime
  endTime     DateTime?
  logs        ExamLog[]
  createdAt   DateTime  @default(now())
}

model ExamLog {
  id             String    @id @default(uuid())
  examId         String
  exam           ExamRoom  @relation(fields: [examId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  eventType      LogType
  codeSnapshot   String?   // State of the code at the time of the event
  details        String?   // JSON object with details (as string)
  createdAt      DateTime  @default(now())
}

enum LogType {
  JOIN
  LEAVE
  EXECUTE
  COPY_PASTE_ALERT
  SUSPICIOUS_BEHAVIOR
}
